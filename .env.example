APP_ENV=development
LOG_LEVEL=INFO
CONFIG_FILE=config/default.yaml

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/dubbing

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Local dev WITHOUT Docker/Redis: run celery in-process (eager). The app reads
# CELERY_TASK_ALWAYS_EAGER itself (celery does NOT auto-read env vars) and, in
# eager mode, switches the result backend to cache+memory and runs the pipeline
# on a background thread so the API event loop is never blocked.
# CELERY_TASK_ALWAYS_EAGER=true
# CELERY_TASK_EAGER_PROPAGATES=true
# CELERY_RESULT_BACKEND=cache+memory://

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/storage
# WORK_DIR=
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=video-dubbing
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

STT_PROVIDER=stub
TRANSLATION_PROVIDER=stub
TTS_PROVIDER=stub
DIARIZATION_PROVIDER=stub

# Optional: constrain the number of speakers diarization should find.
# DIARIZATION_MIN_SPEAKERS=2
# DIARIZATION_MAX_SPEAKERS=4

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

API_KEY_AUTH_ENABLED=false
API_KEY=

# --- Operational limits (all configurable via env / config file / secrets / cloud) ---
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=600
ALLOWED_VIDEO_FORMATS=mp4,mov,avi,mkv
MAX_CONCURRENT_UPLOADS=10
MAX_CONCURRENT_PROCESSING_JOBS=5
PROCESSING_TIMEOUT_SECONDS=1800
RETRY_COUNT=3
QUEUE_MAX_LENGTH=1000

# --- Secrets management channel ---
# Point at a directory whose files are read as settings (filename == field
# name, e.g. secrets/huggingface_token, secrets/gemini_api_key). Ideal for
# Docker secrets / Kubernetes-mounted secret volumes. Values here override the
# YAML file but are themselves overridden by .env / environment variables.
# SECRETS_DIR=/run/secrets

# --- Cloud configuration services channel ---
# Optional URL of a cloud config service that serves a YAML/JSON blob of
# settings (AWS AppConfig config-extension agent, Consul, Vault agent, ...).
# Every instance pulls the same values. Unreachable/invalid services are
# ignored (logged) and never block startup. Overrides the YAML file, but is
# overridden by env vars / .env / secrets dir.
# CLOUD_CONFIG_URL=http://localhost:2772/applications/vdp/environments/prod/configurations/settings
# CLOUD_CONFIG_TIMEOUT_SECONDS=3

OTEL_ENABLED=true
OTEL_EXPORTER_ENDPOINT=